#!/bin/sh
# main only accepts merges; direct commits are rejected.
# Local fast-fail guard — the real enforcement lives in the GitHub branch protection rule.

protected="${RW_PROTECTED_BRANCH:-main}"
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)

if [ "$branch" = "$protected" ]; then
  echo "✖ Direct commits to '${protected}' are blocked: this branch only accepts merges." >&2
  echo "  Create a branch, commit there, then open a pull request." >&2
  exit 1
fi

exit 0
